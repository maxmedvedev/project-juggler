<idea-plugin>
    <id>maxmedvedev.project-juggler</id>
    <name>Project Juggler</name>
    <vendor>Max Medvedev</vendor>

    <description><![CDATA[
        Opens any project in its own IntelliJ instance with an isolated configuration: separate config, system,
        logs and plugins directories per project, copied from your main IDE on first open. Caches of one project
        never slow down another.<br>
        <br>
        Press <code>Cmd+Shift+P</code>/<code>Ctrl+Shift+P</code> for "Recent Juggled Projects": reopen or switch to a
        project, browse for a new one, or open it with another installed IDE.<br>
        <br>
        <ul>
            <li>Sync VM options, configuration or plugins from the main IDE to one or all projects; a running
                instance closes and reopens by itself, including the one you are working in.</li>
            <li>Mark one project as the main project; it opens in the main IDE with the base settings.</li>
            <li>"Open a Project Copy" creates a git worktree on a new branch and opens it isolated.</li>
            <li>Offers a plugin sync after an IDE update, warns when the stored base paths drift, and imports
                recent projects from the IDE.</li>
            <li>Settings | Tools | Project Juggler holds the main project, base paths and limits.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.ProjectJugglerBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="project-juggler.notifications" displayType="BALLOON" bundle="messages.ProjectJugglerBundle"
                           key="notification.group.project-juggler.notifications"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.shutdown.ShutdownSignalServiceStartupActivity"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.startup.PluginSyncOnUpdateActivity"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.startup.StaleMainProjectCleanupActivity"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.startup.IdePathsCheckActivity"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.startup.SelfSyncResultActivity"/>
        <postStartupActivity implementation="com.projectjuggler.plugin.startup.PublishSyncHelperActivity"/>
        <applicationConfigurable parentId="tools"
                                 instance="com.projectjuggler.plugin.settings.ProjectJugglerConfigurable"
                                 id="com.projectjuggler.plugin.settings"
                                 bundle="messages.ProjectJugglerBundle" key="settings.display.name"/>
    </extensions>

    <applicationListeners>
        <listener class="com.projectjuggler.plugin.shutdown.ShutdownSignalAppListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <actions resource-bundle="messages.ProjectJugglerBundle">
        <action id="com.projectjuggler.plugin.OpenWithProjectJuggler"
                class="com.projectjuggler.plugin.actions.OpenWithProjectJugglerAction"
                icon="AllIcons.Actions.Execute">
            <add-to-group group-id="FileMenu" anchor="after" relative-to-action="OpenFile"/>
        </action>
        <action id="com.projectjuggler.plugin.ShowRecentProjects"
                class="com.projectjuggler.plugin.actions.ShowRecentProjectsAction"
                icon="AllIcons.Actions.Search">
            <add-to-group group-id="FileMenu" anchor="after"
                          relative-to-action="com.projectjuggler.plugin.OpenWithProjectJuggler"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift P"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift P"/>
        </action>

        <action id="com.projectjuggler.plugin.OpenProjectCopy"
                class="com.projectjuggler.plugin.actions.OpenProjectCopyAction"
                icon="AllIcons.Actions.Copy">
            <add-to-group group-id="FileMenu" anchor="after" relative-to-action="com.projectjuggler.plugin.ShowRecentProjects"/>
        </action>
    </actions>
</idea-plugin>
